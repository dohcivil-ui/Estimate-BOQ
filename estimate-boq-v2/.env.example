# ───────────────────────────────────────────────────────────
# Supabase (frontend ใช้ public anon key เท่านั้น)
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริงจาก Supabase dashboard
# ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ───────────────────────────────────────────────────────────
# Dev bypass (ปลอดภัยเพราะ Vite จะ strip ออกตอน build เป็น production)
# - ตั้ง = "true" จะข้าม login + ใช้ fake admin user
# - ห้ามใช้ใน production deploy เด็ดขาด
# ───────────────────────────────────────────────────────────
VITE_DEV_BYPASS_AUTH=false

# ───────────────────────────────────────────────────────────
# AI Vision — รองรับ 5 engine (priority: claude > gpt4o > gemini-pro > gemini-flash > qwen)
# ใส่อย่างน้อย 1 key เพื่อให้ AI วิเคราะห์ได้
#
# Key mapping (1 key เปิดได้หลาย engine):
#   VITE_OPENROUTER_API_KEY → claude + gpt4o
#   VITE_GEMINI_API_KEY     → gemini-pro + gemini-flash
#   VITE_QWEN_API_KEY_DEV   → qwen
# ───────────────────────────────────────────────────────────

# OpenRouter — เปิด Claude Sonnet 4 + GPT-4o ด้วย key เดียว (อ่านแบบไทยดีที่สุด)
# สมัครที่ https://openrouter.ai → Keys → Create Key
VITE_OPENROUTER_API_KEY=your-openrouter-key

# Google AI Studio — เปิด Gemini 2.5 Pro + Flash ด้วย key เดียว (ฟรี 1,500 req/วัน)
# สมัครที่ https://aistudio.google.com → Get API key
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Qwen 3.5 Flash (fallback ถูกสุด)
# Production: ตั้งเป็น Supabase secrets — frontend ไม่เห็น
#   supabase secrets set QWEN_API_KEY=sk-xxx
#   supabase secrets set QWEN_MODEL=qwen3.5-flash
#   supabase secrets set QWEN_MODEL_HD=qwen-vl-max
#   supabase secrets set QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# ───────────────────────────────────────────────────────────
# DEV-ONLY (INSECURE): เรียก Qwen ตรงจาก browser
# ใช้ก่อน deploy Edge Function — เปิดใช้เมื่อใส่ค่าจริงในตัวแปรนี้
# ใช้คู่กับ Google login จริงได้ (ไม่ต้องเปิด VITE_DEV_BYPASS_AUTH)
# ⚠️ ห้ามใช้ใน production deploy — API key จะหลุดมา browser
# ก่อน deploy production: ลบ VITE_QWEN_API_KEY_DEV ออก แล้ว deploy Edge Function แทน
# ───────────────────────────────────────────────────────────
VITE_QWEN_API_KEY_DEV=
VITE_QWEN_ENDPOINT_DEV=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VITE_QWEN_MODEL_DEV=qwen3.5-flash
