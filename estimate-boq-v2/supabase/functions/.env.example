# Secrets สำหรับ Supabase Edge Functions
# ใช้กับคำสั่ง: supabase functions serve (รัน function ใน local)
# หรือ:        supabase secrets set <KEY>=<VALUE>  (deploy ขึ้น cloud)
#
# ห้าม commit ไฟล์จริง (.env) — เฉพาะไฟล์ .env.example นี้

# Qwen API (DashScope International)
QWEN_API_KEY=sk-your-key-here
QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
QWEN_MODEL_HD=qwen-vl-max
